#cloud-config
# Vultr user-data — paste into "Cloud-Init User-Data" at deploy
# (Additional Features → Enable Cloud-Init User-Data), or:
#   vultr-cli instance user-data set <id> -d vultr-cloud-config.yaml
# Target: Ubuntu 22.04 / 24.04 (Vultr stock images)

package_update: true
package_upgrade: true
package_reboot_if_required: false
packages:
  - curl
  - ca-certificates

users:
  # no "default" entry — avoids creating the stock "ubuntu" account
  - name: jth
    gecos: Joseph T. Herrmann
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    lock_passwd: true
    ssh_authorized_keys:
      # Vultr does not reliably merge console-selected SSH keys when
      # user-data is present — put the public key here.
      - ssh-rsa  josephherrmann@MacBook-Air.local

runcmd:
  # Install Tailscale (official installer handles apt repo + package)
  - curl -fsSL https://tailscale.com/install.sh | sh
  # Join tailnet. runcmd runs as root, so no sudo needed.
  - tailscale up --auth-key=tskey-auth-kEr3q5uHf421CNTRL-cotvtAJmRTi3ttPK8jkvSiKSTrzxLBL6
  # Scrub the auth key from the persisted user-data copy on disk
  - sed -i 's/tskey-auth-[A-Za-z0-9-]*/REDACTED/' /var/lib/cloud/instance/user-data.txt || true

final_message: "cloud-init done in $UPTIME s — jth ready, tailscale up"
