#!/bin/bash
# pipefail so `npm install … | tail -3` style pipes can't mask non-zero exits
# from the actual installer. `set -u` catches accidental unset-var typos.
set -euo pipefail

# ══════════════════════════════════════════════════════════════════════════════
# Toolchains — cross-platform
#
# Runs AFTER the Brewfile.core install (lexically `install-brewfile` < `install-toolchains`),
# so the static binaries this script initializes (fnm, supabase tap) are
# already on PATH via brew.
# ══════════════════════════════════════════════════════════════════════════════

# Ensure brew is on PATH
{{- if eq .chezmoi.os "darwin" }}
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
{{- else }}
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi
{{- end }}

# Rust: install via official rustup-init script. We deliberately don't use
# `brew install rustup` because Linuxbrew ships only the `rustup` binary
# without ~/.cargo/bin proxies for `cargo` / `rustc`; the upstream installer
# does it right on both macOS and Linux. .zshrc already sources ~/.cargo/env.
if [[ ! -f "$HOME/.cargo/env" ]]; then
  echo "→ Installing Rust via the official rustup-init script..."
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --default-toolchain stable
fi
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# Node via fnm (fnm itself is in Brewfile.core)
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell bash)" 2>/dev/null || true
  if ! command -v node >/dev/null 2>&1; then
    echo "→ Installing Node LTS via fnm..."
    fnm install --lts
    fnm default lts-latest
  fi
fi

# npm globals (cross-platform tools we want everywhere)
if command -v npm >/dev/null 2>&1; then
  NPM_TOOLS=(
    "@anthropic-ai/claude-code"
    "wrangler"
    "ctx7"
    "@mem0/cli"
  )
  for pkg in "${NPM_TOOLS[@]}"; do
    if ! npm list -g --depth=0 "$pkg" >/dev/null 2>&1; then
      echo "→ Installing $pkg..."
      npm install -g "$pkg"
    fi
  done
fi

# Supabase CLI via brew tap (not in core Brewfile because it needs a tap)
# Homebrew intermittently emits "Error: Broken pipe" (SIGPIPE on its own stdout)
# after a successful install, causing a non-zero exit that trips set -e.  Retry
# up to 3 times and treat the install as successful if the binary lands in PATH,
# even if brew's exit code was non-zero.
if ! command -v supabase >/dev/null 2>&1 && command -v brew >/dev/null 2>&1; then
  echo "→ Installing Supabase CLI..."
  _brew_ok=0
  for _attempt in 1 2 3; do
    if brew install supabase/tap/supabase; then
      _brew_ok=1; break
    fi
    # Binary present despite non-zero exit → SIGPIPE on brew's output, not a
    # real failure; consider it done.
    if command -v supabase >/dev/null 2>&1; then
      _brew_ok=1; break
    fi
    echo "  attempt $_attempt/3 failed, retrying in 5 s…"
    sleep 5
  done
  [[ $_brew_ok -eq 1 ]] || { echo "ERROR: supabase install failed after 3 attempts" >&2; exit 1; }
fi
