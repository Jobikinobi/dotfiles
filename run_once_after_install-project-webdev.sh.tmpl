#!/bin/bash
# webdev profile — one-time setup for web / frontend development environments.
#
# Self-gates on the `projects` list in ~/.config/chezmoi/chezmoi.toml
# containing "webdev". On a machine without the key this is a no-op.
#
# What this does NOT do (intentionally):
#   - Does not clone any repo or install project-specific deps.
#   - Does not run `npm install` / `pnpm install` / `bun install` — do that
#     inside the project directory after cloning.
#   - Does not wire Vercel project configs — run `vercel link` per project.
{{- if not (has "webdev" .projects) }}
exit 0
{{- else }}
set -euo pipefail

echo "→ Configuring 'webdev' profile..."

# ── Verify Node is available via fnm (installed by core) ───────────────────
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell bash 2>/dev/null)" || true
  if command -v node >/dev/null 2>&1; then
    echo "✓ node $(node --version) via fnm on PATH"
  else
    echo "→ Installing Node LTS via fnm..."
    fnm install --lts
    fnm default lts-latest
    eval "$(fnm env --shell bash 2>/dev/null)" || true
    echo "✓ node $(node --version) installed"
  fi
fi

if command -v bun >/dev/null 2>&1; then
  echo "✓ bun $(bun --version 2>/dev/null) on PATH"
fi

if command -v pnpm >/dev/null 2>&1; then
  echo "✓ pnpm $(pnpm --version 2>/dev/null) on PATH"
fi

if command -v vercel >/dev/null 2>&1; then
  echo "✓ vercel CLI on PATH"
fi

echo ""
echo "╔═══════════════════════════════════════════════════════════════╗"
echo "║  webdev profile activated                                     ║"
echo "╠═══════════════════════════════════════════════════════════════╣"
echo "║  Runtimes available:                                          ║"
echo "║    node  (via fnm — use \`fnm install <ver>\` to pin)          ║"
echo "║    bun   (all-in-one runtime + bundler + pkg mgr)             ║"
echo "║                                                               ║"
echo "║  Package managers: npm, pnpm, bun                             ║"
echo "║                                                               ║"
echo "║  Deployment:                                                  ║"
echo "║    vercel deploy         # push to Vercel                     ║"
echo "║    vercel dev            # local dev server with edge config   ║"
echo "║    vercel env pull .env  # sync env vars from Vercel          ║"
echo "╚═══════════════════════════════════════════════════════════════╝"
{{- end }}
