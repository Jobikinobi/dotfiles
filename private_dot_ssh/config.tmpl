# =============================================================================
# Cloudflare Sandbox containers (worker: sandbox-bridge / app: sandbox-bridge-sandbox)
# =============================================================================
# There is no public port and no tunnel: `wrangler containers ssh --stdio`
# authenticates against the Cloudflare account with the OAuth token in
# ~/.wrangler and pipes the SSH stream over stdin/stdout. That makes it a
# textbook ProxyCommand, which is what buys native ssh/scp/rsync + VS Code
# Remote-SSH against a container that exposes nothing to the internet.
#
# Two non-obvious details, both of which will silently break this if changed:
#
#  1. `wrangler containers ssh` wants the RAW instance UUID, but %h expands to
#     the whole alias (`cf-sandbox-<uuid>`). The inner `sh -c` strips the
#     `cf-sandbox-` prefix off $1 so the alias stays human-typeable.
#  2. The wrangler on $PATH is an fnm *multishell* shim
#     (~/.local/state/fnm_multishells/<pid>_<ts>/bin) whose path contains a PID
#     and dies with the shell that created it. ProxyCommand runs in a bare
#     non-interactive sh with no fnm init, so it MUST use the stable alias path
#     below or connections fail with "wrangler: not found".
#
# Usage — instance IDs come from `sbx list` (or `wrangler containers instances <APP_ID>`):
#     ssh cf-sandbox-<instance-id>
#     scp file.txt cf-sandbox-<instance-id>:/workspace/
# Containers are ephemeral: the disk resets when an instance sleeps, and a new
# instance gets a NEW id, so these aliases are inherently short-lived.
Host cf-sandbox-*
	ProxyCommand sh -c 'exec "$HOME/.local/share/fnm/aliases/default/bin/wrangler" containers ssh --stdio "${1#cf-sandbox-}"' _ %h
	User cloudchamber
	IdentityFile ~/.ssh/id_ed25519_cfsandbox
	IdentitiesOnly yes
	StrictHostKeyChecking accept-new
	UserKnownHostsFile /dev/null
