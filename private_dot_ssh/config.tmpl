# --- Proxmox hypervisor (root-only by design) ---
# `pve-admin` is an alias for this same host, not a separate machine. It was
# once a distinct entry pointing at 192.168.68.60 as user jth — see the note
# below for why that was never real.
Host pve proxmox pve-admin
	HostName 10.0.0.100
	User root
	IdentityFile ~/.ssh/id_ed25519_pve
	IdentitiesOnly yes
	PreferredAuthentications publickey,password,keyboard-interactive
	ForwardAgent no
	UserKnownHostsFile ~/.ssh/known_hosts

