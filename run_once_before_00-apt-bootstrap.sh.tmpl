{{- if ne .chezmoi.os "darwin" -}}
#!/bin/bash
# Apt prerequisites for Linux dotfiles bootstrap.
#
# Runs BEFORE the homebrew install script because:
#   - The Linuxbrew installer needs build-essential, procps, curl, file, git
#     already present.
#   - Everything downstream of this assumes zsh is installed and the user's
#     login shell is zsh (the .zshrc never runs in bash).
#
# Idempotent: only installs missing packages; only changes the login shell
# if it isn't already zsh.
set -e

# Detect apt; skip on non-Debian/Ubuntu Linux gracefully.
if ! command -v apt-get >/dev/null 2>&1; then
  echo "→ No apt-get — skipping apt prereq install (not a Debian/Ubuntu system)"
  exit 0
fi

NEEDED_PACKAGES=(
  build-essential
  ca-certificates
  curl
  file
  git
  gnupg
  procps
  zsh
  # mDNS / zero-config LAN discovery (Avahi stack)
  avahi-daemon
  avahi-utils
  libnss-mdns
)

MISSING=()
for pkg in "${NEEDED_PACKAGES[@]}"; do
  if ! dpkg -s "$pkg" >/dev/null 2>&1; then
    MISSING+=("$pkg")
  fi
done

if [[ ${#MISSING[@]} -gt 0 ]]; then
  echo "→ Installing apt prereqs: ${MISSING[*]}"
  sudo DEBIAN_FRONTEND=noninteractive apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${MISSING[@]}"
fi

# Set zsh as the default shell for the current user (idempotent).
# Use `id -un` rather than $USER because $USER isn't set in some non-login
# contexts (e.g. Docker `RUN` steps where `USER jth` sets the uid but not the
# env var). Fall back to `whoami` if id isn't available, which is paranoia.
TARGET_USER="$(id -un 2>/dev/null || whoami 2>/dev/null || true)"
ZSH_PATH="$(command -v zsh)"
if [[ -n "$ZSH_PATH" && -n "$TARGET_USER" ]]; then
  if ! grep -qx "$ZSH_PATH" /etc/shells; then
    echo "$ZSH_PATH" | sudo tee -a /etc/shells > /dev/null
  fi
  CURRENT_SHELL="$(getent passwd "$TARGET_USER" | cut -d: -f7)"
  if [[ "$CURRENT_SHELL" != "$ZSH_PATH" ]]; then
    echo "→ Setting login shell to zsh for $TARGET_USER"
    sudo chsh -s "$ZSH_PATH" "$TARGET_USER"
  fi
fi
{{- end -}}
