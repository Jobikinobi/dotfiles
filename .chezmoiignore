# Skip age-encrypted files when the identity key isn't present yet.
#
# This block is SELF-MAINTAINING: it globs the source tree for encrypted_*
# sources and derives each target path, so adding a new encrypted file needs
# no edit here. The previous hand-enumerated list silently went stale every
# time a file was added, and a missed entry makes `chezmoi apply` hard-fail
# on a fresh machine (age exits 1; chezmoi does NOT skip gracefully).
#
# Unlock with:  dotfiles-unlock     (see bin/dotfiles-unlock)
{{- if not (stat (joinPath .chezmoi.homeDir ".config/chezmoi/key.txt")) }}
{{- range $p := glob (joinPath .chezmoi.sourceDir "**" "encrypted_*") }}
{{- $r := trimPrefix (printf "%s/" $.chezmoi.sourceDir) $p }}
{{- $r = replace "dot_" "." $r }}
{{- $r = replace "private_" "" $r }}
{{- $r = replace "encrypted_" "" $r }}
{{ trimSuffix ".age" $r }}
{{- end }}
{{/* the skm symlink would dangle without its target */}}
.ssh/id_ed25519
{{- end }}
