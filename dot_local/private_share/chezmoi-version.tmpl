{{- $sd := .chezmoi.sourceDir -}}
# Managed by chezmoi — do not edit by hand. Regenerated by `chezmoi apply`.
#
# Answers "what version of the dotfiles is this machine actually running?"
# Before this file existed, nothing did: version.txt is in .chezmoiignore and so
# was never deployed, which meant the release tags could not be audited against
# any real host. See dotfiles#144.
#
# Shell-sourceable on purpose, so scripts can read it without parsing:
#   . ~/.local/share/chezmoi-version && echo "$DOTFILES_VERSION"
#
# Every value here derives only from the source tree, never from the clock. An
# apply timestamp would make this file differ on *every* apply, and a `chezmoi
# diff` that is never clean is a `chezmoi diff` nobody reads — which would
# undercut the "check diff before apply" rule in CLAUDE.md. Use the file's mtime
# if you need to know when these values last changed.

# Semver of the last release cut by release-please. Read from the source tree via
# `include`, which still works on an ignored file — .chezmoiignore only suppresses
# target generation, so version.txt stays the single source of truth undeployed.
DOTFILES_VERSION={{ include "version.txt" | trim }}

# The git ref this machine installed from: a branch name (`main`, `stable`), or an
# exact tag when pinned via `chezmoi init --tag vX.Y.Z` (a detached checkout, which
# has no symbolic ref). This is the field that tells you whether a host is tracking
# a release channel or riding unreviewed main.
DOTFILES_REF={{ output "sh" "-c" (printf "git -C %q symbolic-ref --short -q HEAD 2>/dev/null || git -C %q describe --tags --exact-match HEAD 2>/dev/null || echo unknown" $sd $sd) | trim }}

# Exact source commit, so a host can be reproduced even if the branch has moved.
# Both git lookups fall back to `unknown` rather than failing: the source dir is
# not a git repo on tarball or image-baked installs, and an unresolvable ref must
# not abort the whole apply.
DOTFILES_SHA={{ output "sh" "-c" (printf "git -C %q rev-parse --short HEAD 2>/dev/null || echo unknown" $sd) | trim }}

DOTFILES_HOST={{ .chezmoi.hostname }}
