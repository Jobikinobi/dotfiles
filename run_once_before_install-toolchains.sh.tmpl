#!/bin/bash
set -e

# ══════════════════════════════════════════════════════════════════════════════
# Tailscale — cross-platform (runs on macOS and Linux)
# ══════════════════════════════════════════════════════════════════════════════

if ! command -v tailscale &>/dev/null; then
{{- if eq .chezmoi.os "darwin" }}
  echo "→ Tailscale: install via 'brew install --cask tailscale' or Brewfile"
{{- else }}
  echo "→ Installing Tailscale..."
  curl -fsSL https://tailscale.com/install.sh | sh
  echo "✓ Tailscale installed"
{{- end }}
fi

{{- if ne .chezmoi.os "darwin" }}
# On Linux, start tailscaled and join the tailnet if an auth key is available.
# Project's server-tag auth key lives at backend/dev, secret name TAILSCALE_AUTHKEY_SERVER.
if command -v tailscale &>/dev/null; then
  if ! tailscale status &>/dev/null; then
    sudo systemctl enable --now tailscaled 2>/dev/null || true
    if command -v doppler &>/dev/null; then
      TS_AUTHKEY="$(doppler secrets get TAILSCALE_AUTHKEY_SERVER --plain -p backend -c dev 2>/dev/null)" || true
      if [[ -n "$TS_AUTHKEY" ]]; then
        echo "→ Joining tailnet..."
        sudo tailscale up --authkey="$TS_AUTHKEY" --ssh --advertise-tags=tag:server
        echo "✓ Joined tailnet with Tailscale SSH enabled"
      else
        echo "⚠ Tailscale installed but no auth key — run 'sudo tailscale up' manually"
      fi
    else
      echo "⚠ Tailscale installed but Doppler not available — run 'sudo tailscale up' manually"
    fi
  else
    echo "✓ Tailscale already connected"
  fi
fi
{{- end }}

# ══════════════════════════════════════════════════════════════════════════════
# Toolchains — cross-platform via brew
#
# Brewfile.core installs the static packages (go, rustup, fnm, uv, doppler, …).
# This block handles per-tool runtime initialization (rustup-init, fnm-managed
# Node, npm globals) and brew taps (supabase) that Brewfile bundles don't carry.
# ══════════════════════════════════════════════════════════════════════════════

# Ensure brew is on PATH
{{- if eq .chezmoi.os "darwin" }}
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
{{- else }}
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi
{{- end }}

# Rust: rustup-init only — brew install of rustup happens via Brewfile.core
if command -v rustup-init >/dev/null 2>&1 && [[ ! -f "$HOME/.cargo/env" ]]; then
  echo "→ Initializing rustup..."
  rustup-init -y --no-modify-path --default-toolchain stable
fi
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# Node via fnm (fnm itself is in Brewfile.core)
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell bash)" 2>/dev/null || true
  if ! command -v node >/dev/null 2>&1; then
    echo "→ Installing Node LTS via fnm..."
    fnm install --lts
    fnm default lts-latest
  fi
fi

# npm globals (cross-platform tools we want everywhere)
if command -v npm >/dev/null 2>&1; then
  NPM_TOOLS=(
    "@anthropic-ai/claude-code"
    "wrangler"
    "ctx7"
    "@mem0/cli"
  )
  for pkg in "${NPM_TOOLS[@]}"; do
    if ! npm list -g --depth=0 "$pkg" >/dev/null 2>&1; then
      echo "→ Installing $pkg..."
      npm install -g "$pkg" 2>&1 | tail -3
    fi
  done
fi

# Supabase CLI via brew tap (not in core Brewfile because it needs a tap)
if ! command -v supabase >/dev/null 2>&1 && command -v brew >/dev/null 2>&1; then
  echo "→ Installing Supabase CLI..."
  brew install supabase/tap/supabase
fi
